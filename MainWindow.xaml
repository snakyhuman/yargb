<Window x:Class="Jargb.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="JARGB" Icon="Assets/Jargb.ico" Width="422" Height="431" ResizeMode="NoResize"
        WindowStyle="None" WindowStartupLocation="CenterScreen"
        Background="#12121A" Foreground="#F7F4FF" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="Tile" TargetType="Button">
            <Setter Property="Background" Value="#1D1C28"/>
            <Setter Property="Foreground" Value="#EEEAF8"/>
            <Setter Property="BorderBrush" Value="#333042"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TileBorder" CornerRadius="11" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="#2A2738"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="#DDD2FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TileBorder" Property="Opacity" Value=".78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TileBorder" Property="Opacity" Value=".55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource Tile}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="29"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        </Style>
        <Style x:Key="PresetEdit" TargetType="Button" BasedOn="{StaticResource Tile}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#BAADD1"/>
            <Setter Property="Width" Value="23"/>
            <Setter Property="Height" Value="23"/>
        </Style>
        <Style x:Key="BrightnessTrack" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BrightnessControl" TargetType="Slider">
            <Setter Property="Foreground" Value="#B296FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid x:Name="SliderSurface" Height="24" Background="Transparent">
                            <Border Margin="5,0" Height="4" CornerRadius="2" Background="#40384D"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource BrightnessTrack}" Command="Slider.DecreaseLarge"
                                                  Background="{TemplateBinding Foreground}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <Ellipse Width="14" Height="14" Fill="#C3ACFF" Stroke="#241D33" StrokeThickness="1"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource BrightnessTrack}" Command="Slider.IncreaseLarge"
                                                  Background="Transparent"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SliderSurface" Property="Opacity" Value=".55"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SliderSurface" Property="Background" Value="#282335"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#353044" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="43"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="20,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}"
                           Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="JARGB" FontSize="13" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource CaptionButton}" Content="−" Click="Minimize"
                            AutomationProperties.Name="Свернуть" AutomationProperties.AutomationId="minimize"/>
                    <Button Style="{StaticResource CaptionButton}" Content="×" Click="CloseWindow"
                            AutomationProperties.Name="Закрыть" AutomationProperties.AutomationId="close"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="19,7,19,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="71"/>
                    <RowDefinition Height="49"/>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border CornerRadius="15" BorderThickness="1" BorderBrush="#4A3C67">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                            <GradientStop Color="#221C30" Offset="0"/>
                            <GradientStop Color="#3C2B58" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid Margin="15,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Подсветка" FontSize="26" FontWeight="SemiBold"/>
                            <TextBlock Text="JARGB_V2 · оба разъёма" Foreground="#CEC1E3" FontSize="12" Margin="1,3,0,0"/>
                        </StackPanel>
                        <Button x:Name="Power" Style="{StaticResource Tile}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Width="91" Height="40" Click="TogglePower" AutomationProperties.AutomationId="power">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="13" Height="14" Stroke="{Binding Foreground, ElementName=Power}" StrokeThickness="1.6"
                                      Data="M6.5,0 L6.5,7 M3,2.5 A5.8,5.8 0 1 0 10,2.5" Margin="0,1,7,0"/>
                                <TextBlock x:Name="PowerText" Text="…" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="1" Text="Пресеты" Foreground="#C7BDD6" FontSize="12" FontWeight="SemiBold" Margin="1,5,0,0"/>
                <UniformGrid x:Name="Palette" Grid.Row="2" Columns="4" Margin="-3,0"/>
                <Grid Grid.Row="3" VerticalAlignment="Center" Margin="1,7,1,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Яркость" Foreground="#C7BDD6" FontSize="12" FontWeight="SemiBold"/>
                    <Slider x:Name="BrightnessSlider" Grid.Column="1" Style="{StaticResource BrightnessControl}"
                            Minimum="10" Maximum="100" Value="100" SmallChange="10" LargeChange="10"
                            TickFrequency="10" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                            AutomationProperties.Name="Яркость подсветки" AutomationProperties.AutomationId="brightness"
                            ValueChanged="BrightnessChanged"/>
                    <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=BrightnessSlider, StringFormat={}{0:0}%}"
                               HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"/>
                </Grid>
                <Button x:Name="Game" Grid.Row="4" Margin="0,12,0,0" Style="{StaticResource Tile}"
                        HorizontalContentAlignment="Stretch" Padding="12,0" Click="ToggleGameSync" ToolTip="Игровые эффекты из установленного Mystic Light"
                        AutomationProperties.Name="Game Sync" AutomationProperties.AutomationId="game">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="33" Height="33" CornerRadius="9" Background="#392D50" Margin="0,0,10,0">
                                <Path Width="19" Height="13" Stroke="#C7ABFF" StrokeThickness="1.45"
                                      Data="M4,1 L14,1 Q16.5,1 17,4 L18,9 Q18,13 15,11 L12,8 L6,8 L3,11 Q0,13 0,9 L1,4 Q1.5,1 4,1 M3,5 L7,5 M5,3 L5,7 M12,5 L13,5 M15,5 L16,5"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Game Sync" FontWeight="SemiBold"/>
                                <TextBlock x:Name="GameText" AutomationProperties.AutomationId="game-status" Text="Mystic Light" TextTrimming="CharacterEllipsis" MaxWidth="260" Foreground="#B9AACD" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="GameSwitch" Text="Выкл" Foreground="#BDABDD" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>
                </Button>
                <DockPanel Grid.Row="5" VerticalAlignment="Bottom" Margin="1,0,0,0" LastChildFill="True">
                    <Ellipse x:Name="StatusDot" Fill="#817792" Width="6" Height="6" Margin="0,0,7,0"/>
                    <TextBlock x:Name="Status" Text="Подключение…" FontSize="11" Foreground="#C7BDD6"
                               TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="status"/>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
